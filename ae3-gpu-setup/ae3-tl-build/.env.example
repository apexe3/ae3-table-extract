# Settings for docker run --env-file .env. Copy to .env and set the key; every other value
# has a default in the image.
AE3_PORT=8000

# Every request must carry this key: X-API-Key: <key>, or Authorization: Bearer <key>.
# There is no default. The service refuses to start while this is empty.
# Make one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AE3_API_KEY=

# tesseract reads pages without a text layer; none turns OCR off.
OCR_ENGINE=tesseract

# PDF input is off in this release: the service accepts page images only and a PDF is refused.
AE3_PDF_INPUT=0

# The crop endpoint is off by default; set 1 to turn it on.
AE3_ENABLE_CROP=0

# Limits. Queue depth is how many extractions run at once.
AE3_MAX_IMAGE_MB=25
AE3_MAX_IMAGE_PIXELS=60000000
AE3_MAX_PDF_MB=50
AE3_MAX_PAGES=100
AE3_SYNC_PAGE_LIMIT=20
AE3_QUEUE_LIMIT=8
AE3_JOB_LIMIT=8

# ONNX Runtime intra-op threads. 0 lets it use every core, which is right for one copy.
# With AE3_COPIES=N the entrypoint sets cores / N per copy unless this is set.
AE3_THREADS=0

# The cell builder: fast is the vectorised one and the default; legacy is the old per-object
# path in postprocess/postprocess.py. Both give the same cells.
AE3_CELL_BUILDER=fast

# Bounded in-process cache of uploads, so a file_id works across two calls on one copy.
AE3_CACHE_MB=256

# file_url and words_url are off by default. To turn them on, set 1 and name the hosts that may
# be fetched; a request to any other host is refused.
AE3_ALLOW_OUTBOUND=0
AE3_FETCH_ALLOWLIST=
